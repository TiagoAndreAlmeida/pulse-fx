# Copie para `.env` e preencha os valores reais:
#   cp .env.example .env
# O `.env` é ignorado pelo git — nunca comite chaves reais.

# Conexão PostgreSQL (dev local; no Docker Compose o host é `db`, ver docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse_fx?schema=public

# Porta da API
PORT=3333

# Chave do FRED (obrigatória p/ FEDFUNDS e CPI_US): https://fredaccount.stlouisfed.org/apikeys
# Sem ela a API nem sobe (o provider valida na inicialização) e o sync do FRED falha.
FRED_API_KEY=SUA_CHAVE_FRED_AQUI

# Chave do endpoint admin POST /admin/sync (header `x-admin-key`). Gere uma forte.
ADMIN_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE
